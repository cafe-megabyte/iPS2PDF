+bool CPDF_PageContentGenerator::EmitComplexColor(fxcrt::ostringstream* buf,
+                                                 const CPDF_Color* color,
+                                                 bool is_stroke) {
+  if (!color) {
+    return false;
+  }
+
+  if (color->IsPattern()) {
+    RetainPtr<CPDF_Pattern> pattern = color->GetPattern();
+    if (!pattern) {
+      return false;
+    }
+    RetainPtr<CPDF_Object> pattern_obj = pattern->GetPatternObjForRegen();
+    if (!pattern_obj || pattern_obj->GetObjNum() == 0) {
+      return false;
+    }
+    ByteString name;
+    auto it = realized_pattern_names_.find(pattern_obj->GetObjNum());
+    if (it != realized_pattern_names_.end()) {
+      name = it->second;
+    } else {
+      name = RealizeResource(pattern_obj.Get(), "Pattern");
+      if (name.IsEmpty()) {
+        return false;
+      }
+      realized_pattern_names_[pattern_obj->GetObjNum()] = name;
+    }
+    emitted_pattern_resources_.insert(name);
+
+    // Uncoloured (PaintType 2) patterns carry the paint colour as scn
+    // operands and REQUIRE a /Pattern colourspace with the underlying space
+    // as its parameter (ISO 32000-1 §8.7.3.3): "[/Pattern base] cs c1..cn
+    // /Name scn".  The parsed colour's space is the CPDF_PatternCS; a
+    // non-null base marks the uncoloured form.
+    RetainPtr<CPDF_ColorSpace> pattern_space = color->GetColorSpace();
+    const CPDF_PatternCS* pattern_cs =
+        pattern_space ? pattern_space->AsPatternCS() : nullptr;
+    RetainPtr<CPDF_ColorSpace> base_cs =
+        pattern_cs ? pattern_cs->base_cs() : nullptr;
+    if (base_cs) {
+      pdfium::span<const float> pat_comps = color->GetRawPatternComps();
+      const uint32_t base_count = base_cs->ComponentCount();
+      if (base_count > 0 && pat_comps.size() >= base_count) {
+        ByteString pcs_name;
+        auto pcs_cached = realized_cs_names_.find(pattern_space.Get());
+        if (pcs_cached != realized_cs_names_.end()) {
+          pcs_name = pcs_cached->second;
+        } else {
+          auto pattern_cs_array = document_->NewIndirect<CPDF_Array>();
+          pattern_cs_array->AppendNew<CPDF_Name>("Pattern");
+          if (const CPDF_Array* base_array = base_cs->GetArray()) {
+            if (base_array->GetObjNum() != 0) {
+              pattern_cs_array->AppendNew<CPDF_Reference>(
+                  document_, base_array->GetObjNum());
+            } else {
+              RetainPtr<CPDF_Object> base_clone = base_array->Clone();
+              if (base_clone) {
+                document_->AddIndirectObject(base_clone);
+                pattern_cs_array->AppendNew<CPDF_Reference>(
+                    document_, base_clone->GetObjNum());
+              }
+            }
+          } else {
+            // Stock/device underlying space  - reference it by family name.
+            const char* device_name = nullptr;
+            switch (base_cs->GetFamily()) {
+              case CPDF_ColorSpace::Family::kDeviceGray:
+                device_name = "DeviceGray";
+                break;
+              case CPDF_ColorSpace::Family::kDeviceRGB:
+                device_name = "DeviceRGB";
+                break;
+              case CPDF_ColorSpace::Family::kDeviceCMYK:
+                device_name = "DeviceCMYK";
+                break;
+              default:
+                break;
+            }
+            if (device_name) {
+              pattern_cs_array->AppendNew<CPDF_Name>(device_name);
+            }
+          }
+          if (pattern_cs_array->size() == 2) {
+            pcs_name = RealizeResource(pattern_cs_array.Get(), "ColorSpace");
+            if (!pcs_name.IsEmpty()) {
+              realized_cs_names_[pattern_space.Get()] = pcs_name;
+            }
+          }
+        }
+        if (!pcs_name.IsEmpty()) {
+          emitted_colorspace_resources_.insert(pcs_name);
+          *buf << "/" << PDF_NameEncode(pcs_name)
+               << (is_stroke ? " CS " : " cs ");
+          for (uint32_t i = 0; i < base_count; ++i) {
+            WriteFloat(*buf, pat_comps[i]) << " ";
+          }
+          *buf << "/" << PDF_NameEncode(name)
+               << (is_stroke ? " SCN " : " scn ");
+          return true;
+        }
+      }
+    }
+
+    *buf << "/Pattern" << (is_stroke ? " CS /" : " cs /")
+         << PDF_NameEncode(name) << (is_stroke ? " SCN " : " scn ");
+    return true;
+  }
+
+  pdfium::span<const float> comps = color->GetRawNonPatternComps();
+  if (comps.empty()) {
+    return false;
+  }
+  RetainPtr<CPDF_ColorSpace> cs = color->GetColorSpace();
+  if (!cs) {
+    return false;
+  }
+
+  // DeviceCMYK: the plain k/K operator, no resource needed.
+  if (cs->GetFamily() == CPDF_ColorSpace::Family::kDeviceCMYK) {
+    if (comps.size() != 4) {
+      return false;
+    }
+    for (size_t i = 0; i < comps.size(); ++i) {
+      WriteFloat(*buf, comps[i]) << " ";
+    }
+    *buf << (is_stroke ? "K " : "k ");
+    return true;
+  }
+
+  // Every other colourspace: realize its backing array as a /ColorSpace
+  // resource and emit "/Name cs c1 .. cn scn".  Stock/device spaces have no
+  // backing array and were already handled above / by WriteColorToStream.
+  ByteString cs_name;
+  auto cached = realized_cs_names_.find(cs.Get());
+  if (cached != realized_cs_names_.end()) {
+    cs_name = cached->second;
+  } else {
+    const CPDF_Array* arr = cs->GetArray();
+    if (!arr) {
+      return false;
+    }
+    if (arr->GetObjNum() != 0) {
+      // Already an indirect object  - reference it directly (shared, no
+      // clone).
+      cs_name = RealizeResource(arr, "ColorSpace");
+    } else {
+      // Direct (inline) array  - clone into a fresh indirect object so it can
+      // be referenced by name.  The clone keeps inner /Reference entries
+      // (tint-transform function, alternate space, Indexed base) pointing at
+      // their existing objects, so nothing is duplicated.
+      RetainPtr<CPDF_Object> indirect = arr->Clone();
+      if (!indirect) {
+        return false;
+      }
+      document_->AddIndirectObject(indirect);
+      cs_name = RealizeResource(indirect.Get(), "ColorSpace");
+    }
+    if (cs_name.IsEmpty()) {
+      return false;
+    }
+    realized_cs_names_[cs.Get()] = cs_name;
+  }
+  emitted_colorspace_resources_.insert(cs_name);
+
+  *buf << "/" << PDF_NameEncode(cs_name) << (is_stroke ? " CS " : " cs ");
+  for (size_t i = 0; i < comps.size(); ++i) {
+    WriteFloat(*buf, comps[i]) << " ";
+  }
+  *buf << (is_stroke ? "SCN " : "scn ");
+  return true;
+}
