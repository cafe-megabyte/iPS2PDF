+static bool AllExistingContentStreamsRewritten(
+    CPDF_PageObjectHolder* obj_holder,
+    const std::set<int32_t>& rewritten_stream_indices) {
+  int32_t existing_count = 0;
+  // Form XObjects keep their content in the XObject stream itself (index 0);
+  // pages keep theirs in /Contents (single stream or an array of streams).
+  if (obj_holder->GetMutableFormStream()) {
+    existing_count = 1;
+  } else if (RetainPtr<const CPDF_Object> contents =
+                 obj_holder->GetDict()->GetDirectObjectFor(
+                     pdfium::page_object::kContents)) {
+    // NOTE: must dereference  - /Contents is virtually always an indirect
+    // reference (`N 0 R`).  GetObjectFor would return the CPDF_Reference
+    // itself, which is neither an array nor a stream.
+    if (const CPDF_Array* arr = contents->AsArray()) {
+      existing_count = static_cast<int32_t>(arr->size());
+    } else if (contents->IsStream()) {
+      existing_count = 1;
+    }
+  }
+  for (int32_t i = 0; i < existing_count; ++i) {
+    if (!pdfium::Contains(rewritten_stream_indices, i)) {
+      return false;
+    }
+  }
+  return true;
+}
