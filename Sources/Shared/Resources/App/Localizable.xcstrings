    "The catalogue targets Ghostscript %@. Missing settings are inserted into the active user Joboptions; unrelated source bytes stay unchanged.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Katalog gilt für Ghostscript %@. Fehlende Einstellungen werden in die aktiven Benutzer-Joboptions eingefügt; nicht betroffene Quelldaten bleiben unverändert."
          }
        }
      }
    },
    "The current PDF version requires temporary conversion adjustments. The active Joboptions remain unchanged unless you apply them.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
